# ==========================================
# CẤU HÌNH BOT DISCORD - BẢO VỆ TÀI LIỆU
# ==========================================

# 1. Token của Bot lấy từ Discord Developer Portal -> Bot -> Reset Token
DISCORD_TOKEN=your_bot_token_here

# 2. Application ID (Client ID) từ Discord Developer Portal -> General Information
CLIENT_ID=your_client_id_here

# 3. Server ID (Guild ID) nơi bạn muốn đăng ký lệnh và chạy bot
# (Bật Developer Mode trên Discord -> Chuột phải vào tên Server -> Copy Server ID)
GUILD_ID=your_guild_id_here

# 4. Kênh ID để Bot gửi LOG mỗi khi có người bấm tải tài liệu
# (Chuột phải vào kênh text của Admin -> Copy Channel ID)
LOG_CHANNEL_ID=your_admin_log_channel_id_here

# ==========================================
# CẤU HÌNH BẢO MẬT & CHỐNG CLONE (TÙY CHỌN)
# ==========================================

# Số ngày tối thiểu của tài khoản Discord kể từ khi tạo (chặn nick clone mới tạo)
# Mặc định: 7 ngày
MIN_ACCOUNT_AGE_DAYS=7

# Số ngày tối thiểu kể từ khi tham gia server này
# Mặc định: 1 ngày
MIN_JOIN_DAYS=1

# Role ID bắt buộc để được tải (nếu để trống, mọi thành viên đủ tuổi nick đều được tải)
REQUIRED_ROLE_ID=

# 5. ID Discord của Chủ sở hữu Bot (Toàn quyền sử dụng mọi lệnh ở mọi server)
OWNER_ID=490681384684355604


